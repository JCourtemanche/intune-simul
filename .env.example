# ============================================================================
# Intune Simulator (Exposure Management -> Intune patch demo) - Configuration
# ============================================================================
# Copier ce fichier en .env puis renseigner les valeurs. Ne jamais commiter .env.

# ----------------------------------------------------------------------------
# Cortex XSIAM API (tenant de demo avec l'addon Exposure Management)
# ----------------------------------------------------------------------------
# Settings -> Configurations -> API Keys. Cle "Standard", role Instance Administrator.
# XSIAM_BASE_URL = "Copy API URL" (commence par https://api-...)
XSIAM_BASE_URL=https://api-your-tenant.xdr.eu.paloaltonetworks.com
XSIAM_API_KEY_ID=1
XSIAM_API_KEY=your_api_key_here

# ----------------------------------------------------------------------------
# Identifiants factices Entra ID / Graph exposes par le simulateur
# ----------------------------------------------------------------------------
# A reporter dans l'instance de l'integration "Intune (Demo)" cote XSIAM.
SIM_TENANT_ID=00000000-0000-0000-0000-000000000000
SIM_CLIENT_ID=11111111-1111-1111-1111-111111111111
SIM_CLIENT_SECRET=change-me-intune-simulator-secret

# ----------------------------------------------------------------------------
# Deploiement GCP Cloud Run (meme convention que les autres simulateurs)
# ----------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west1
CLOUD_RUN_SERVICE=intune-simulator
# URL publique du service, renseignee apres le premier deploiement
SIMULATOR_URL=https://intune-simulator-xxxxxxxx-ew.a.run.app
